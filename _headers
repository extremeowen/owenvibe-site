# Заголовки для Netlify (працюють і при drag & drop, і при Git-деплої)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com https://plausible.io https://gc.zgo.at https://ntfy.sh; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Сервіс-воркер і HTML не кешуємо — інакше оновлення не долетить
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS без хешу в імені: короткий кеш + перевірка
/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate

# Іконки й картинки — можна довго
/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# Дані статистики оновлюються щодня
/repos.json
  Cache-Control: public, max-age=3600




